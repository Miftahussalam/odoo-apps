<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="res_city_view_search" model="ir.ui.view">
            <field name="name">res.city.search</field>
            <field name="model">res.city</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="state_id"/>
                    <field name="subdistrict_ids"/>
                </search>
            </field>
        </record>

        <record id="res_city_view_list" model="ir.ui.view">
            <field name="name">res.city.list</field>
            <field name="model">res.city</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="state_id"/>
                    <field name="subdistrict_ids"/>
                </list>
            </field>
        </record>

        <record id="res_city_view_form" model="ir.ui.view">
            <field name="name">res.city.form</field>
            <field name="model">res.city</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                            </group>
                            <group>
                                <field name="state_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Kecamatan">
                                <field name="subdistrict_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="res_city_action" model="ir.actions.act_window">
            <field name="name">Kabupaten / Kota</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.city</field>
            <field name="view_mode">list,form</field>
            <!-- res.city sekarang dipakai bareng base_address_extended, yang
                 punya list/form sendiri buat model yang sama (field zipcode/
                 country_id, tanpa tab Kecamatan). Pin eksplisit ke view kita
                 sendiri di sini, jangan andalkan resolusi default Odoo yang
                 bisa milih view core alih-alih ini. -->
            <field name="view_ids" eval="[
                (5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('res_city_view_list')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('res_city_view_form')}),
            ]"/>
            <!-- Menu ini khusus Kabupaten/Kota Indonesia - res.city sekarang
                 bisa juga diisi negara lain lewat modul core lain, jangan
                 sampai ikut nongol/ketimpa di sini. -->
            <field name="domain" eval="[('country_id', '=', ref('base.id'))]"/>
            <field name="context" eval="{'default_country_id': ref('base.id')}"/>
        </record>

        <menuitem id="res_city_menu" parent="contacts.menu_localisation" action="res_city_action" sequence="3"/>

    </data>
</odoo>
