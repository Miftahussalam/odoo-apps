<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <template id="report_invoice_document" inherit_id="account.report_invoice_document">
            <xpath expr="//div[@id='qrcode']" position="after">
                <t t-if="o.partner_id.invoice_signature">
                    <br/>
                    <br/>
                    <div style="width:100%; text-align:right; page-break-inside: avoid;">
                        <div style="display:inline-block; width:35%; text-align:center;">
                            <div>Tertanda,</div>
                            <br/><br/><br/><br/><br/><br/>
                            <div><span t-esc="o.company_id.name"/></div>
                        </div>
                    </div>
                    <br/>
                    <br/>
                </t>
            </xpath>
        </template>
    
    </data>
</odoo>
