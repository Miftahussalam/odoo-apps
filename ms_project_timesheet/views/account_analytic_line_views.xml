<odoo>
    <data>

        <record id="hr_timesheet_line_search" model="ir.ui.view">
            <field name="name">account.analytic.line.search</field>
            <field name="model">account.analytic.line</field>
            <field name="inherit_id" ref="hr_timesheet.hr_timesheet_line_search"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="state"/>
                </field>
                <filter name="mine" position="after">
                    <separator/>
                    <filter name="state_open" string="Open" domain="[('state', '=', 'open')]"/>
                    <filter name="state_invoiced" string="Invoiced" domain="[('state', '=', 'invoiced')]"/>
                    <filter name="state_paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                    <filter name="state_cancel" string="Cancel" domain="[('state', '=', 'cancel')]"/>
                </filter>
                <filter name="groupby_project" position="after">
                    <filter string="Customer" name="groupby_customer" domain="[]" context="{'group_by': 'partner_id'}" help="Timesheet by Customer"/>
                    <filter string="State" name="groupby_state" domain="[]" context="{'group_by':'state'}"/>
                </filter>
            </field>
        </record>

        <record id="hr_timesheet_line_tree" model="ir.ui.view">
            <field name="name">account.analytic.line.list</field>
            <field name="model">account.analytic.line</field>
            <field name="inherit_id" ref="hr_timesheet.hr_timesheet_line_tree"/>
            <field name="arch" type="xml">

                <xpath expr="//list" position="attributes">
                    <attribute name="decoration-danger">break_time != False</attribute>
                    <attribute name="decoration-info">end_time == False</attribute>
                </xpath>
                <xpath expr="//field[@name='date']" position="attributes">
                    <attribute name="optional">hide</attribute>
                </xpath>
                <xpath expr="//field[@name='unit_amount']" position="before">
                    <field name="start_time"/>
                    <field name="break_time" optional="hide"/>
                    <field name="end_time"/>
                    <button name="button_start_stop"
                            type="object"
                            string="Start / Stop"
                            icon="fa-play"
                            class="btn-success"/>
                    <button name="button_break_resume"
                            type="object"
                            string="Break / Resume"
                            icon="fa-pause"
                            class="btn-warning"/>
                    <field name="break_unit_amount" widget="timesheet_uom" sum="Total" optional="hide" string="Break (h)"/>
                </xpath>
                <xpath expr="//field[@name='unit_amount']" position="after">
                    <field name="amount" sum="Total Amount" groups="hr_timesheet.group_timesheet_manager" optional="hide"/>
                    <field name="developer_amount" sum="Total Amount" groups="ms_project_timesheet.group_hr_timesheet_developer" optional="hide"/>
                    <field name="real_amount" sum="Total Amount" groups="hr_timesheet.group_timesheet_manager" string="Real Amt"/>
                    <field name="target_amount" groups="hr_timesheet.group_timesheet_manager" string="Target Amt"/>
                    <field name="is_state_readonly" column_invisible="1"/>
                    <field name="state" readonly="is_state_readonly" force_save="1"/>
                </xpath>
                <xpath expr="//field[@name='employee_id']" position="attributes">
                    <attribute name="column_invisible">0</attribute>
                    <attribute name="optional">hide</attribute>
                    <attribute name="groups">hr_timesheet.group_timesheet_manager</attribute>
                </xpath>
                <xpath expr="//field[@name='task_id']" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </xpath>

            </field>
        </record>

        <record id="timesheet_view_tree_user" model="ir.ui.view">
            <field name="name">account.analytic.line.list</field>
            <field name="model">account.analytic.line</field>
            <field name="inherit_id" ref="hr_timesheet.timesheet_view_tree_user"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='employee_id']" position="attributes">
                    <attribute name="column_invisible">0</attribute>
                    <attribute name="optional">hide</attribute>
                </xpath>
            </field>
        </record>

        <record id="hr_timesheet_line_form" model="ir.ui.view">
            <field name="name">account.analytic.line.form</field>
            <field name="model">account.analytic.line</field>
            <field name="inherit_id" ref="hr_timesheet.hr_timesheet_line_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='task_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='amount']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='name']" position="after">
                    <field name="state"/>
                </xpath>
                <xpath expr="//field[@name='unit_amount']" position="before">
                    <field name="start_time"/>
                    <field name="end_time"/>
                    <field name="break_unit_amount" string="Break (h)"/>
                </xpath>

            </field>
        </record>

        <record id="timesheet_view_form_user" model="ir.ui.view">
            <field name="name">account.analytic.line.form</field>
            <field name="model">account.analytic.line</field>
            <field name="inherit_id" ref="hr_timesheet.timesheet_view_form_user"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='employee_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

            </field>
        </record>

        <record id="model_account_analytic_line_export_excel" model="ir.actions.server">
            <field name="name">Export to Excel</field>
            <field name="model_id" ref="analytic.model_account_analytic_line"/>
            <field name="binding_model_id" ref="analytic.model_account_analytic_line"/>
            <field name="state">code</field>
            <field name="code">
                records.action_export_to_excel()
            </field>
        </record>

        <record id="model_account_analytic_line_generate_invoice" model="ir.actions.server">
            <field name="name">Generate Invoice</field>
            <field name="model_id" ref="analytic.model_account_analytic_line"/>
            <field name="binding_model_id" ref="analytic.model_account_analytic_line"/>
            <field name="state">code</field>
            <field name="code">
                records.action_generate_invoice()
            </field>
        </record>

        <record id="model_account_analytic_line_invoiced" model="ir.actions.server">
            <field name="name">Set to Invoiced</field>
            <field name="model_id" ref="analytic.model_account_analytic_line"/>
            <field name="binding_model_id" ref="analytic.model_account_analytic_line"/>
            <field name="state">code</field>
            <field name="code">
                records.action_set_to_invoiced()
            </field>
        </record>

        <record id="model_account_analytic_line_open" model="ir.actions.server">
            <field name="name">Set to Open</field>
            <field name="model_id" ref="analytic.model_account_analytic_line"/>
            <field name="binding_model_id" ref="analytic.model_account_analytic_line"/>
            <field name="state">code</field>
            <field name="code">
                records.action_set_to_open()
            </field>
        </record>

        <record id="model_account_analytic_line_paid" model="ir.actions.server">
            <field name="name">Set to Paid</field>
            <field name="model_id" ref="analytic.model_account_analytic_line"/>
            <field name="binding_model_id" ref="analytic.model_account_analytic_line"/>
            <field name="state">code</field>
            <field name="code">
                records.action_set_to_paid()
            </field>
        </record>

        <record id="model_account_analytic_line_cancel" model="ir.actions.server">
            <field name="name">Set to Cancel</field>
            <field name="model_id" ref="analytic.model_account_analytic_line"/>
            <field name="binding_model_id" ref="analytic.model_account_analytic_line"/>
            <field name="state">code</field>
            <field name="code">
                records.action_set_to_cancel()
            </field>
        </record>

        <record id="hr_timesheet.timesheet_menu_activity_user" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>
        <record id="hr_timesheet.timesheet_menu_activity_mine" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>
        <record id="hr_timesheet.menu_timesheets_reports_timesheet" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>

    </data>
</odoo>
